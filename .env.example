# Public site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=replace-with-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-11

# Server-only Sanity preview access
SANITY_API_READ_TOKEN=

# Contact delivery (server only)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Static-hosting contact-form fallback. Public contact methods are centralized
# in src/config/site.ts.
NEXT_PUBLIC_CONTACT_EMAIL=contact@photographefes.com

# Required for server contact delivery in production; never NEXT_PUBLIC_.
# The trusted proxy must overwrite the chosen header with ONE client IP and
# prevent requests reaching the origin directly. Leave unset for local dev.
CONTACT_RATE_LIMIT_IP_HEADER=
# HTTPS Redis REST endpoint ending in .upstash.io (no path/query/credentials).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
